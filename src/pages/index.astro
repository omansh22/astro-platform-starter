            <div class="value-card">
                <i>🤝</i>
                <h3>Trust</h3>
                <p>Building lasting relationships through transparency and reliable service.</p>
            </div>
            <div class="value-card">
                <i>🏆</i>
                <h3>Excellence</h3>
                <p>Excellence in service and professional installation.</p>
