<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PowerNest - Home</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f5f5f5;
        }
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 50px;
            background-color: white;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        }
        .header .logo img {
            width: 150px;
            height: auto;
            object-fit: contain;
        }
        .header nav a {
            margin-left: 20px;
            text-decoration: none;
            color: #333;
            font-size: 16px;
        }
        .hero {
            position: relative;
            height: 500px;
            background: url('https://via.placeholder.com/1200x500.png?text=Solar+Panels') no-repeat center center/cover;
            color: white;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 0 50px;
        }
        .hero h1 {
            font-size: 48px;
            margin: 0;
            text-transform: uppercase;
        }
        .hero p {
            font-size: 20px;
            margin: 10px 0 20px;
        }
        .hero .buttons {
            display: flex;
            gap: 20px;
        }
        .hero button {
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            font-size: 16px;
            cursor: pointer;
        }
        .hero .quote-btn {
            background-color: #28a745;
            color: white;
        }
        .hero .services-btn {
            background-color: transparent;
            color: white;
            border: 1px solid white;
        }
        .section {
            padding: 50px;
            text-align: center;
        }
        .section h2 {
            font-size: 32px;
            margin-bottom: 20px;
        }
        .section p {
            font-size: 16px;
            color: #666;
            max-width: 800px;
            margin: 0 auto 40px;
        }
        .values, .services, .testimonials {
            display: flex;
            justify-content: space-around;
            flex-wrap: wrap;
            gap: 20px;
        }
        .value-card, .service-card, .testimonial-card {
            background-color: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            width: 30%;
            text-align: center;
        }
        .value-card i, .service-card i {
            font-size: 40px;
            color: #28a745;
            margin-bottom: 10px;
        }
        .value-card h3, .service-card h3, .testimonial-card h3 {
            font-size: 20px;
            margin: 10px 0;
        }
        .service-card img {
            width: 100%;
            height: 150px;
            object-fit: cover;
            border-radius: 8px;
            margin-bottom: 10px;
        }
        .service-card a, .testimonial-card .stars {
            color: #28a745;
            text-decoration: none;
            font-size: 14px;
        }
        .testimonial-card img {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            margin: 10px auto;
            display: block;
        }
        .testimonial-card p {
            font-style: italic;
            color: #333;
        }
        .testimonial-card .author {
            font-size: 14px;
            color: #666;
            margin-top: 10px;
        }
        .footer {
            background-color: #1a2a44;
            color: white;
            padding: 20px;
            display: flex;
            justify-content: space-around;
            flex-wrap: wrap;
        }
        .footer div {
            margin: 10px 0;
        }
        .footer .logo img {
            width: 150px;
            height: auto;
            object-fit: contain;
            margin-bottom: 10px;
        }
        .footer p, .footer a {
            color: white;
            text-decoration: none;
            font-size: 14px;
            margin: 5px 0;
        }
        .footer .social-icons a {
            margin: 0 10px;
            font-size: 20px;
            color: white;
            text-decoration: none;
        }
        .footer .copyright {
            text-align: center;
            width: 100%;
            margin-top: 20px;
            font-size: 12px;
            color: #bbb;
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="logo">
            <img src="/logo.svg" alt="PowerNest Logo">
        </div>
        <nav>
