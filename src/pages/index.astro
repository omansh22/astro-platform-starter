        <div class="services">
            <div class="service-card">
                <img src="https://via.placeholder.com/300x150.png?text=Residential+Solar" alt="Residential Solar">
                <h3>Residential Solar Panels</h3>
                <p>Custom solar solutions for homes, reducing energy bills while increasing property value.</p>
                <a href="#">Learn More →</a>
            </div>
            <div class="service-card">
                <img src="https://via.placeholder.com/300x150.png?text=Commercial+Solar" alt="Commercial Solar">
                <h3>Commercial Installations</h3>
                <p>Large-scale solar solutions for businesses and industrial facilities.</p>
                <a href="#">Learn More →</a>
            </div>
            <div class="service-card">
                <img src="https://via.placeholder.com/300x150.png?text=Maintenance+Monitoring" alt="Maintenance & Monitoring">
                <h3>Maintenance & Monitoring</h3>
                <p>24/7 system monitoring and regular maintenance services.</p>
                <a href="#">Learn More →</a>
            </div>
        </div>
    </div>
